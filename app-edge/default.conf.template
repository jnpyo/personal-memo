# This file is rendered by the nginx-unprivileged entrypoint. The Dockerfile limits envsubst to
# PUBLIC_APP_HOSTNAME so Nginx runtime variables remain intact.

map_hash_bucket_size 256;
server_names_hash_bucket_size 128;

map $request_method $personal_memo_app_method_class {
    default "other";
    GET "read";
    HEAD "read";
    POST "write";
    PATCH "write";
    DELETE "write";
}

map $uri $personal_memo_app_route_class {
    default "rejected";
    "~^/assets/[A-Za-z0-9._-]+-[A-Za-z0-9_-]{8,}\.[A-Za-z0-9]+$" "hashed-static";
    "~^/workbox-[0-9a-f]{8,}\.js$" "hashed-static";
    ~^/assets/ "static";
    ~^/icons/ "static";
    / "spa-shell";
    /index.html "spa-shell";
    /login "spa-shell";
    /sw.js "pwa";
    /registerSW.js "pwa";
    /manifest.webmanifest "pwa";
    /calendar/v1/feed.ics "blocked";
    ~^/actuator(?:/|$) "blocked";
    ~^/_internal(?:/|$) "blocked";
    "~^/api/v1/auth/register(?:[;/]|$)" "blocked";
    ~^/oauth2(?:/|$) "blocked";
    ~^/login/oauth2(?:/|$) "blocked";
    ~^/api/v1/ "api";
}

# Every response is non-cacheable unless both its normalized path proves that it is a
# content-hashed build artifact and its final status is a cache-safe success/revalidation status.
# This prevents an absent asset or a transient upstream failure from being cached for a year. The
# edge hides upstream cache headers before applying this policy.
map "$uri:$status" $personal_memo_app_cache_control {
    default "no-store";
    "~^/assets/[A-Za-z0-9._-]+-[A-Za-z0-9_-]{8,}\.(?:avif|css|gif|ico|jpe?g|js|png|svg|webp|woff2?):(?:200|206|304)$" "public, max-age=31536000, immutable";
    "~^/workbox-[0-9a-f]{8,}\.js:(?:200|206|304)$" "public, max-age=31536000, immutable";
}

map $request_method $personal_memo_app_method_allowed {
    default 0;
    GET 1;
    HEAD 1;
    POST 1;
    PATCH 1;
    DELETE 1;
}

map $request_method $personal_memo_app_unsafe_method {
    default 0;
    POST 1;
    PATCH 1;
    DELETE 1;
}

map $http_origin $personal_memo_app_trusted_origin {
    default 0;
    "https://${PUBLIC_APP_HOSTNAME}" 1;
}

# Cookie names are case-sensitive. Each regex selects the first exact, bounded application cookie;
# empty or malformed values are omitted. The final header is reconstructed from these two values,
# so Cloudflare Access and arbitrary caller cookies never cross the origin boundary.
map $http_cookie $personal_memo_app_session_cookie_value {
    default "";
    "~(?:^|;[ ]*)SESSION=(?<personal_memo_app_session_cookie_capture>[A-Za-z0-9._~+/%=-]{1,256})(?:;|$)" $personal_memo_app_session_cookie_capture;
}

map $http_cookie $personal_memo_app_xsrf_cookie_value {
    default "";
    "~(?:^|;[ ]*)XSRF-TOKEN=(?<personal_memo_app_xsrf_cookie_capture>[A-Za-z0-9._~+/%=-]{1,256})(?:;|$)" $personal_memo_app_xsrf_cookie_capture;
}

map "$personal_memo_app_session_cookie_value|$personal_memo_app_xsrf_cookie_value" $personal_memo_app_cookie_allowlist {
    default "";
    "~^(?<personal_memo_app_session_only>[A-Za-z0-9._~+/%=-]{1,256})\|$" "SESSION=$personal_memo_app_session_only";
    "~^\|(?<personal_memo_app_xsrf_only>[A-Za-z0-9._~+/%=-]{1,256})$" "XSRF-TOKEN=$personal_memo_app_xsrf_only";
    "~^(?<personal_memo_app_session_both>[A-Za-z0-9._~+/%=-]{1,256})\|(?<personal_memo_app_xsrf_both>[A-Za-z0-9._~+/%=-]{1,256})$" "SESSION=$personal_memo_app_session_both; XSRF-TOKEN=$personal_memo_app_xsrf_both";
}

map "$personal_memo_app_unsafe_method:$personal_memo_app_trusted_origin" $personal_memo_app_reject_origin {
    default 0;
    "1:0" 1;
}

# cloudflared terminates every public request at the same loopback origin. These are deliberately
# global origin-side bounds; Cloudflare Access/WAF limits remain additional perimeter controls.
map $server_name $personal_memo_app_limit_key {
    default "public-app";
}

map $server_name $personal_memo_app_login_limit_key {
    default "public-app-login";
}

limit_req_zone $personal_memo_app_limit_key zone=personal_memo_app_rate:1m rate=120r/m;
limit_req_zone $personal_memo_app_login_limit_key zone=personal_memo_app_login_rate:1m rate=10r/m;
limit_conn_zone $personal_memo_app_limit_key zone=personal_memo_app_connections:1m;

# Logs contain only finite classifications and numeric transport outcomes. In particular they omit
# URI, query, Host, addresses, cookies, Referer, Authorization, and every Cloudflare field.
log_format personal_memo_app_edge_safe
    'method_class=$personal_memo_app_method_class route_class=$personal_memo_app_route_class '
    'status=$status bytes=$body_bytes_sent duration=$request_time';

add_header Cache-Control $personal_memo_app_cache_control always;
add_header Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'; worker-src 'self' blob:; manifest-src 'self'" always;
add_header Cross-Origin-Opener-Policy "same-origin" always;
add_header Cross-Origin-Resource-Policy "same-origin" always;
add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()" always;
add_header Referrer-Policy "no-referrer" always;
add_header Strict-Transport-Security "max-age=86400" always;
add_header X-Content-Type-Options "nosniff" always;
add_header X-Frame-Options "DENY" always;

# Unknown hosts have no application upstream. The sole exception is the container-loopback health
# probe; the published host-loopback port and tunnel peer cannot satisfy this address ACL.
server {
    listen 8080 default_server;
    listen [::]:8080 default_server;
    server_name _;

    server_tokens off;
    access_log /dev/stdout personal_memo_app_edge_safe;
    error_log /dev/null emerg;

    client_header_timeout 10s;
    client_body_timeout 10s;
    client_max_body_size 256k;
    client_body_buffer_size 32k;
    client_header_buffer_size 2k;
    large_client_header_buffers 4 8k;
    keepalive_timeout 15s;
    keepalive_requests 50;
    send_timeout 15s;
    reset_timedout_connection on;

    limit_req zone=personal_memo_app_rate burst=30 nodelay;
    limit_req_status 429;
    limit_conn personal_memo_app_connections 32;
    limit_conn_status 429;

    error_page 400 401 403 404 405 408 413 414 421 431 494 495 496 497 500 501 502 503 504 =404 @personal_memo_default_not_found;
    error_page 429 =429 @personal_memo_default_rate_limited;

    location @personal_memo_default_not_found {
        default_type "";
        return 204;
    }

    location @personal_memo_default_rate_limited {
        default_type "";
        return 204;
    }

    location = /_internal/health {
        access_log off;
        allow 127.0.0.1;
        allow ::1;
        deny all;
        empty_gif;
    }

    location / {
        return 404;
    }
}

server {
    listen 8080;
    listen [::]:8080;
    server_name ${PUBLIC_APP_HOSTNAME};

    server_tokens off;
    access_log /dev/stdout personal_memo_app_edge_safe;
    error_log /dev/null emerg;

    merge_slashes on;
    ignore_invalid_headers on;
    underscores_in_headers off;

    client_header_timeout 10s;
    client_body_timeout 10s;
    client_max_body_size 256k;
    client_body_buffer_size 32k;
    client_header_buffer_size 2k;
    large_client_header_buffers 4 8k;
    keepalive_timeout 15s;
    keepalive_requests 50;
    send_timeout 15s;
    reset_timedout_connection on;

    limit_req zone=personal_memo_app_rate burst=30 nodelay;
    limit_req_status 429;
    limit_conn personal_memo_app_connections 32;
    limit_conn_status 429;

    # Local parser/policy failures are indistinguishable, bodyless 404s. Availability failures are
    # bodyless 502s. Application responses retain their own status/body because interception is off.
    error_page 400 403 404 405 408 413 414 421 431 494 495 496 497 =404 @personal_memo_app_not_found;
    error_page 429 =429 @personal_memo_app_rate_limited;
    error_page 500 501 502 503 504 =502 @personal_memo_app_upstream_unavailable;

    location @personal_memo_app_not_found {
        default_type "";
        return 204;
    }

    location @personal_memo_app_rate_limited {
        default_type "";
        return 204;
    }

    location @personal_memo_app_upstream_unavailable {
        default_type "";
        return 204;
    }

    location = /_internal/health {
        access_log off;
        allow 127.0.0.1;
        allow ::1;
        deny all;
        empty_gif;
    }

    # Keep every administrative, alternate-authentication, and calendar-publication surface out of
    # this tunnel. The dedicated calendar edge remains the only calendar publication origin.
    location = /calendar/v1/feed.ics { return 404; }
    location ^~ /calendar/v1/feed.ics/ { return 404; }
    location = /actuator { return 404; }
    location ^~ /actuator/ { return 404; }
    location = /_internal { return 404; }
    location ^~ /_internal/ { return 404; }
    location = /api/v1/auth/register { return 404; }
    location ^~ /api/v1/auth/register/ { return 404; }
    # Spring PathPattern treats semicolon matrix parameters as segment metadata. Block the same
    # registration capability before the generic /api/v1/ proxy when such metadata is present.
    location ^~ "/api/v1/auth/register;" { return 404; }
    location = /oauth2 { return 404; }
    location ^~ /oauth2/ { return 404; }
    location = /login/oauth2 { return 404; }
    location ^~ /login/oauth2/ { return 404; }

    # Only the finite PWA shell/static paths and /api/v1/** can reach the private frontend. There is
    # deliberately no SPA catch-all: a newly introduced public route requires an edge review.
    location = / {
        if ($personal_memo_app_method_class != "read") { return 404; }
        try_files /__personal_memo_app_edge_no_local_file__ @personal_memo_app_frontend;
    }
    location = /index.html {
        if ($personal_memo_app_method_class != "read") { return 404; }
        try_files /__personal_memo_app_edge_no_local_file__ @personal_memo_app_frontend;
    }
    location = /login {
        if ($personal_memo_app_method_class != "read") { return 404; }
        try_files /__personal_memo_app_edge_no_local_file__ @personal_memo_app_frontend;
    }
    location ^~ /assets/ {
        if ($personal_memo_app_method_class != "read") { return 404; }
        try_files /__personal_memo_app_edge_no_local_file__ @personal_memo_app_frontend;
    }
    location ^~ /icons/ {
        if ($personal_memo_app_method_class != "read") { return 404; }
        try_files /__personal_memo_app_edge_no_local_file__ @personal_memo_app_frontend;
    }
    location = /sw.js {
        if ($personal_memo_app_method_class != "read") { return 404; }
        try_files /__personal_memo_app_edge_no_local_file__ @personal_memo_app_frontend;
    }
    location = /registerSW.js {
        if ($personal_memo_app_method_class != "read") { return 404; }
        try_files /__personal_memo_app_edge_no_local_file__ @personal_memo_app_frontend;
    }
    location = /manifest.webmanifest {
        if ($personal_memo_app_method_class != "read") { return 404; }
        try_files /__personal_memo_app_edge_no_local_file__ @personal_memo_app_frontend;
    }
    location ~ "^/workbox-[0-9a-f]{8,}\.js$" {
        if ($personal_memo_app_method_class != "read") { return 404; }
        try_files /__personal_memo_app_edge_no_local_file__ @personal_memo_app_frontend;
    }

    location = /api/v1/auth/login {
        limit_req zone=personal_memo_app_rate burst=30 nodelay;
        limit_req zone=personal_memo_app_login_rate burst=5 nodelay;
        try_files /__personal_memo_app_edge_no_local_file__ @personal_memo_app_frontend;
    }
    location ^~ /api/v1/auth/login/ {
        limit_req zone=personal_memo_app_rate burst=30 nodelay;
        limit_req zone=personal_memo_app_login_rate burst=5 nodelay;
        try_files /__personal_memo_app_edge_no_local_file__ @personal_memo_app_frontend;
    }
    location ^~ /api/v1/ {
        try_files /__personal_memo_app_edge_no_local_file__ @personal_memo_app_frontend;
    }

    location / {
        return 404;
    }

    location @personal_memo_app_frontend {
        # $http_host equality is stricter than server-name selection: it rejects alternate case,
        # trailing dots, and explicit ports instead of silently canonicalizing them. Browser writes
        # also fail closed unless Origin is the one public HTTPS origin.
        if ($http_host != "${PUBLIC_APP_HOSTNAME}") { return 404; }
        if ($personal_memo_app_method_allowed = 0) { return 404; }
        if ($personal_memo_app_reject_origin) { return 404; }

        proxy_pass http://frontend:5173;
        proxy_http_version 1.1;
        proxy_pass_request_headers off;
        proxy_pass_request_body on;
        proxy_request_buffering on;
        proxy_buffering on;
        proxy_buffer_size 8k;
        proxy_buffers 8 16k;
        proxy_busy_buffers_size 32k;
        proxy_max_temp_file_size 1m;

        # Preserve only the application contract. No client-, Cloudflare-, or Access-supplied
        # identity/network header can survive this allowlist. Host and forwarded values are the
        # edge's canonical constants; the browser session, CSRF contract, and body are retained.
        proxy_set_header Host "${PUBLIC_APP_HOSTNAME}";
        proxy_set_header Connection "";
        proxy_set_header Cookie $personal_memo_app_cookie_allowlist;
        proxy_set_header Content-Type $http_content_type;
        proxy_set_header Content-Length $content_length;
        proxy_set_header Accept $http_accept;
        proxy_set_header Origin $http_origin;
        proxy_set_header X-XSRF-TOKEN $http_x_xsrf_token;
        proxy_set_header X-Expected-Owner-Id $http_x_expected_owner_id;
        proxy_set_header Idempotency-Key $http_idempotency_key;
        proxy_set_header X-Analysis-Proposal-Schema-Version $http_x_analysis_proposal_schema_version;
        proxy_set_header If-None-Match $http_if_none_match;
        proxy_set_header If-Modified-Since $http_if_modified_since;
        proxy_set_header X-Forwarded-Host "${PUBLIC_APP_HOSTNAME}";
        proxy_set_header X-Forwarded-Port "443";
        proxy_set_header X-Forwarded-Proto "https";

        proxy_connect_timeout 3s;
        proxy_send_timeout 15s;
        proxy_read_timeout 60s;
        proxy_next_upstream off;
        proxy_intercept_errors off;
        proxy_redirect off;

        proxy_hide_header Access-Control-Allow-Credentials;
        proxy_hide_header Access-Control-Allow-Headers;
        proxy_hide_header Access-Control-Allow-Methods;
        proxy_hide_header Access-Control-Allow-Origin;
        proxy_hide_header Cache-Control;
        proxy_hide_header Content-Security-Policy;
        proxy_hide_header Cross-Origin-Opener-Policy;
        proxy_hide_header Cross-Origin-Resource-Policy;
        proxy_hide_header Expires;
        proxy_hide_header Permissions-Policy;
        proxy_hide_header Referrer-Policy;
        proxy_hide_header Server;
        proxy_hide_header Strict-Transport-Security;
        proxy_hide_header X-Content-Type-Options;
        proxy_hide_header X-Frame-Options;
    }
}
