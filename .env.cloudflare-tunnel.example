# Non-secret review record for a remotely-managed Cloudflare named Tunnel.
# The real file is ignored. Never put a Tunnel token, API token, credentials JSON, or copied
# cloudflared install command in either file.
PERSONAL_MEMO_CLOUDFLARE_PUBLIC_HOSTNAME=calendar.example.com
PERSONAL_MEMO_CLOUDFLARE_REMOTE_PATH=^/calendar/v1/feed\.ics$
PERSONAL_MEMO_CLOUDFLARE_ORIGIN_SERVICE=http://127.0.0.1:8787
PERSONAL_MEMO_CLOUDFLARE_CATCH_ALL_SERVICE=http_status:404
PERSONAL_MEMO_CLOUDFLARE_METRICS_ADDRESS=127.0.0.1:49312

# Dashboard contract, reviewed before the connector is started:
# 1. Use a dedicated calendar.<zone> hostname, not the PWA or API hostname.
# 2. The first and only forwarding rule matches the exact path expression above and sends it to
#    the loopback origin above. Query parameters are deliberately not part of the path expression.
# 3. The final ingress rule has no hostname or path and returns the catch-all service above.
# 4. Keep the connector stopped until publication capability and external token-log sentinels pass.
