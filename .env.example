POSTGRES_DB=personal_memo
POSTGRES_USER=personal_memo
POSTGRES_PASSWORD=local-development-only
SPRING_PROFILES_ACTIVE=dev

# Local account/session defaults for http://127.0.0.1 development.
AUTH_REGISTRATION_ENABLED=true
SESSION_COOKIE_SECURE=false

# Google is optional. Keep it disabled until an OAuth Web client is configured.
# Enabling it without both client credentials intentionally fails backend startup.
GOOGLE_AUTH_ENABLED=false
# Existing Google identities may sign in and authenticated users may link Google regardless of
# this flag. Only automatic creation of a brand-new internal user is gated and defaults closed.
GOOGLE_REGISTRATION_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:5173/login/oauth2/code/google
