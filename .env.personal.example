# Copying this file is not the supported setup path. Run
# scripts/personal/Initialize-PersonalMemo.ps1 so credentials and TLS paths are generated safely.
POSTGRES_DB=personal_memo
POSTGRES_USER=personal_memo_app
POSTGRES_PASSWORD=replace-with-a-random-generated-secret
PERSONAL_MEMO_FRONTEND_PORT=8080

# Documentation-only address and paths used for Compose contract validation.
# The initializer writes the actual private LAN IPv4 and forward-slash Windows paths.
PERSONAL_MEMO_HTTPS_BIND_ADDRESS=192.168.1.100
PERSONAL_MEMO_HTTPS_PORT=8443
PERSONAL_MEMO_TLS_HOSTNAME=personal-memo-host
PERSONAL_MEMO_TLS_CERT_FILE=C:/replace-with/Documents/PersonalMemo/PrivateTls/server-cert.pem
PERSONAL_MEMO_TLS_KEY_FILE=C:/replace-with/Documents/PersonalMemo/PrivateTls/server-key.pem
PERSONAL_MEMO_TLS_CA_FILE=C:/replace-with/Documents/PersonalMemo/PrivateTls/ca-cert.pem

AUTH_REGISTRATION_ENABLED=false
SESSION_COOKIE_SECURE=true
# The private-LAN overlay deliberately keeps Google OAuth and Google-created accounts off.
# Configure Google only after moving to compose.prod.yaml behind a public HTTPS domain.
GOOGLE_AUTH_ENABLED=false
GOOGLE_REGISTRATION_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Initial-account CLI metadata. Keep real values only in ignored .env.personal.
# The password is deliberately absent and must be entered interactively.
PERSONAL_MEMO_BOOTSTRAP_EMAIL=
PERSONAL_MEMO_BOOTSTRAP_DISPLAY_NAME=
PERSONAL_MEMO_BOOTSTRAP_TIME_ZONE=Asia/Seoul

# The following non-secret local-model identity is documentation only. compose.personal.yaml pins
# these exact values directly; do not copy them into or override them from private environment data.
# endpoint/allowed relay origin: http://host.docker.internal:11434
