{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "topicLabels",
    "itemCoverage",
    "items",
    "dateCoverage",
    "dates",
    "reviewFlags"
  ],
  "properties": {
    "title": {
      "type": "string",
      "maxLength": 200
    },
    "topicLabels": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "string",
        "maxLength": 100
      }
    },
    "itemCoverage": {
      "type": "string",
      "enum": ["COMPLETE", "MORE_THAN_THREE"]
    },
    "items": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "title",
          "actionSlot",
          "objectSlot"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "enum": ["TASK", "EVENT", "INFORMATION", "IDEA", "RECORD"]
          },
          "title": {
            "type": "string",
            "maxLength": 200
          },
          "actionSlot": {
            "type": "string",
            "maxLength": 206
          },
          "objectSlot": {
            "type": "string",
            "maxLength": 206
          }
        }
      }
    },
    "dateCoverage": {
      "type": "string",
      "enum": ["COMPLETE", "MORE_THAN_FIVE"]
    },
    "dates": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "surfaceText",
          "interpretation"
        ],
        "properties": {
          "surfaceText": {
            "type": "string",
            "maxLength": 200
          },
          "interpretation": {
            "type": "string",
            "maxLength": 224
          }
        }
      }
    },
    "reviewFlags": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lowTypeMargin",
        "conflictingDates"
      ],
      "properties": {
        "lowTypeMargin": {
          "type": "boolean"
        },
        "conflictingDates": {
          "type": "boolean"
        }
      }
    }
  }
}
