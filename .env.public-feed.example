# Non-secret deployment authority consumed only by the final activation overlay.
# Copy this to an ignored .env.public-feed only after the public hostname, TLS, operator, and
# external log sentinel checks are ready; the preflight edge does not advertise this origin.
APP_CALENDAR_FEED_PUBLIC_ORIGIN=https://calendar.example.com
APP_CALENDAR_FEED_PUBLIC_CONSENT_POLICY_VERSION=calendar-feed-public-v1

# The dedicated edge remains bound to Windows loopback. A reviewed HTTPS tunnel or reverse proxy
# connects to this port; never change the bind address to 0.0.0.0 or publish the main PWA listener.
PERSONAL_MEMO_CALENDAR_EDGE_PORT=8787
